# debug
DEBUG=True
DEBUG_EXTENSIONS=True

# list of allowed hosts
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0

# path to postgres server when running locally. This value overwritten in docker-compose.yml
POSTGRES_HOST=0.0.0.0
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PORT=5433
POSTGRES_VOLUME_NAME=brainspread_postgres

# ports
WEB_PORT=8001

# django stuff
DJANGO_SECRET_KEY=SECRET_KEY_GOES_HERE

# defines docker-compose project name
COMPOSE_PROJECT_NAME=brainspread_dev

# scheduler / reminders (see issue #59)
# set false locally so dev doesn't accidentally ping Discord.
REMINDERS_ENABLED=true
# automations scheduler tick (see issue #143) — same opt-in pattern as
# reminders; set false locally unless you're testing automations.
AUTOMATIONS_ENABLED=true
# poll cadence for the scheduler loop, in seconds
SCHEDULER_INTERVAL_SECONDS=60

# environment label — anything other than "prod"/"production" (or
# unset) gets prepended to reminder messages as `[<env>] ` so you can
# tell which deploy a ping came from. use "local" for dev, "staging"
# for staging.
ENVIRONMENT=production

# absolute base URL of this deploy, used to build links in outbound
# notifications (e.g. the page-link appended to Discord reminders).
# Must start with http:// or https:// — placeholder values are skipped
# rather than producing broken links. Leave unset locally if you don't
# need clickable links in test pings.
SITE_URL=https://brainspread.nutmegranch.com

# comma-separated https origins Django should trust for CSRF — required
# in prod behind https (match SITE_URL); unnecessary locally.
CSRF_TRUSTED_ORIGINS=https://brainspread.nutmegranch.com

# optional: default Anthropic key for the AI chat / model seeding.
# users can also configure provider keys in-app.
ANTHROPIC_API_KEY=

# optional: asset upload caps (defaults shown; override to change)
# ASSET_UPLOAD_MAX_BYTES=26214400
# ASSET_UPLOAD_MIME_WHITELIST=image/png,image/jpeg,...

# NOTE: STAGING_PR_NUMBER / STAGING_PR_URL / STAGING_DISCORD_* are
# injected by the staging deploy workflow — not set by hand.
