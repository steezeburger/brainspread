# debug
DEBUG=True
DEBUG_EXTENSIONS=True

# list of allowed hosts
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0

# path to postgres server when running locally. This value overwritten in docker-compose.yml
POSTGRES_HOST=0.0.0.0
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PORT=5433
POSTGRES_VOLUME_NAME=brainspread_postgres

# ports
WEB_PORT=8001

# django stuff
DJANGO_SECRET_KEY=SECRET_KEY_GOES_HERE

# defines docker-compose project name
COMPOSE_PROJECT_NAME=brainspread_dev

# scheduler / reminders (see issue #59)
# false locally so dev doesn't accidentally ping Discord. staging and
# prod set this to true explicitly in their own .env files.
REMINDERS_ENABLED=false
# poll cadence for the scheduler loop, in seconds
SCHEDULER_INTERVAL_SECONDS=60

# environment label — anything other than "prod" (or unset) gets
# prepended to reminder messages as `[<env>] ` so you can tell which
# deploy a ping came from. staging deploy sets ENVIRONMENT=staging,
# prod sets ENVIRONMENT=prod.
ENVIRONMENT=local

# absolute base URL of this deploy, used to build links in outbound
# notifications (e.g. the page-link appended to Discord reminders).
# Must start with http:// or https:// — placeholder values are skipped
# rather than producing broken links. Leave unset locally if you don't
# need clickable links in test pings.
SITE_URL=

# Web Push (browser notifications) VAPID keypair. Reminders piggyback push
# delivery on top of Discord when the user has an active browser
# subscription. Leave blank to disable browser push — Discord delivery is
# unaffected. Generate a keypair with:
#   uv run vapid --gen && uv run vapid --applicationServerKey
# (run from packages/django-app — the `vapid` CLI ships with pywebpush)
# then derive the raw private key string from the generated
# private_key.pem:
#   uv run python -c "
#   from py_vapid import Vapid02
#   import base64
#   v = Vapid02.from_file('private_key.pem')
#   n = v.private_key.private_numbers().private_value
#   print(base64.urlsafe_b64encode(n.to_bytes(32, 'big')).decode().rstrip('='))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
